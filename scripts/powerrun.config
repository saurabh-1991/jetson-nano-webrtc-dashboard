# Jetson Power-Run configuration
# Edit these values to match your board/network, then run:
#   sudo ./scripts/powerrun_apply_all.sh

# Optional: absolute project path on Jetson
# PROJECT_DIR="/home/saurabh/Saurabh/Jetson_Nano_WebRTC_POC/jetson-nano-webrtc-dashboard"

# ---------------- Boot behavior ----------------
AUTOLOGIN_USER="root"
ENABLE_AUTOLOGIN="true"

# If true, ROOT_PASSWORD must be set.
ENABLE_ROOT_ACCOUNT="false"
ROOT_PASSWORD=""

START_ON_BOOT="true"
START_NOW="true"

# false = reboot uses existing images only (recommended for offline/new LAN usage)
# true  = reboot service may rebuild images if needed
COMPOSE_REBUILD_ON_BOOT="false"

# mDNS LAN discovery (`http://<MDNS_HOSTNAME>.local/`)
ENABLE_MDNS="true"
MDNS_HOSTNAME="jetson-dashboard"

# ---------------- Ethernet profile (field default: DHCP + mDNS) ----------------
ETH_DEVICE="eth0"
# Keep ETH_* empty for plug-and-play across unknown remote subnets.
# If a site requires fixed IP, fill ETH_IP/ETH_GATEWAY/ETH_DNS explicitly.
ETH_IP=""
ETH_GATEWAY=""
ETH_DNS=""

# ---------------- Wi-Fi profile (optional USB dongle fallback) ----------------
# Leave blank to skip Wi-Fi configuration.
# If you want Wi-Fi fallback, set SSID/PASSWORD and keep WIFI_IP empty for DHCP.
WIFI_DEVICE="wlan0"
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_IP=""
WIFI_GATEWAY=""
WIFI_DNS=""
