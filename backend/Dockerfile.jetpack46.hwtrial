# Optional hardware-acceleration trial image for JetPack 4.6 / Jetson Nano
#
# Goal:
# - Use NVIDIA's l4t-ml base (includes a richer CV/ML stack)
# - Validate whether OpenCV in this base exposes GStreamer/CUDA paths
# - Keep this isolated from default production Dockerfile

FROM nvcr.io/nvidia/l4t-ml:r32.7.1-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Ensure media plugins + runtime deps are present
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    libopus-dev \
    libsrtp2-dev \
    libvpx-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    pkg-config \
    git \
    && rm -rf /var/lib/apt/lists/*

# Keep Python tooling compatible with project constraints (Py3.6 line)
RUN pip3 install --upgrade "pip<23" "setuptools<60"
RUN pip3 install "Jetson.GPIO<2.2"

COPY constraints.jetpack46.txt /app/constraints.jetpack46.txt
RUN pip3 install -c /app/constraints.jetpack46.txt "wheel<0.38" "Cython<3"

# Reuse JP4.6 dependency set; intentionally no opencv-python pin here.
COPY requirements.jetpack46.txt /app/requirements.jetpack46.txt
RUN pip3 install -c /app/constraints.jetpack46.txt --no-build-isolation -r /app/requirements.jetpack46.txt

COPY app /app/app
WORKDIR /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
