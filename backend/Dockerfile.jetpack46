# Thin app layer for JetPack 4.6 / Jetson Nano (L4T r32.7.1).
# Extends the frozen base image (system deps + OpenCV/CUDA compiled from
# source). Only application code changes here, so rebuilds are seconds, not
# hours. Rebuild/refresh the base image only via Dockerfile.jetpack46.base
# (see scripts/build_base_image.sh) when JetPack/OpenCV/system deps change.
ARG BASE_IMAGE=jetson-backend-base:jp46-opencv455-v1
FROM ${BASE_IMAGE}

# Copy application code
COPY app /app/app

# Set working directory
WORKDIR /app

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run FastAPI application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
