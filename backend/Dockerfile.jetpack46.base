# Frozen base image for JetPack 4.6 / Jetson Nano (L4T r32.7.1).
# Contains system deps, Python deps, and OpenCV+CUDA built from source.
# This is the expensive, rarely-changing layer (build time ~45-90 min).
# Rebuild ONLY when JetPack/OpenCV/system deps change - NOT for app code changes.
# See scripts/build_base_image.sh and scripts/load_base_image.sh for the
# offline (no-internet) field distribution workflow.
FROM nvcr.io/nvidia/l4t-base:r32.7.1

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install system dependencies and build tools
# python3-numpy: system numpy headers for OpenCV cmake (pip path often invisible to cmake)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    libpython3.6-dev \
    python3-jetson-gpio \
    python3-numpy \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    libopus-dev \
    libsrtp2-dev \
    libvpx-dev \
    build-essential \
    cmake \
    unzip \
    wget \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libgtk-3-dev \
    libatlas-base-dev \
    gfortran \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    pkg-config \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to a reasonably recent version that works on Python 3.6
RUN pip3 install --upgrade "pip<23" "setuptools<60"

# Build tools pinned for Python 3.6 / av build compatibility
COPY constraints.jetpack46.txt /app/constraints.jetpack46.txt
RUN pip3 install -c /app/constraints.jetpack46.txt "wheel<0.38" "Cython<3"

# Copy JetPack-specific requirements (do not include opencv-python / numpy)
COPY requirements.jetpack46.txt /app/requirements.jetpack46.txt
RUN pip3 install -c /app/constraints.jetpack46.txt --no-build-isolation -r /app/requirements.jetpack46.txt || true

# Verify apt numpy is visible to python3/cmake (fail early if not)
RUN python3 -c "import numpy; print('numpy', numpy.__version__, numpy.get_include())"

# Build OpenCV from source with CUDA and GStreamer support (on-device build)
ENV OPENCV_VERSION=4.5.5
WORKDIR /opt
RUN set -eux; \
    PYTHON3_EXEC="$(command -v python3)"; \
    PYTHON3_INCLUDE="$(python3 -c 'from distutils.sysconfig import get_python_inc; print(get_python_inc())')"; \
    PYTHON3_LIB="$(python3 -c 'import distutils.sysconfig as s, os; print(os.path.join(s.get_config_var("LIBDIR"), s.get_config_var("LDLIBRARY")))')"; \
    NUMPY_INCLUDE="$(python3 -c 'import numpy; print(numpy.get_include())')"; \
    wget -q https://github.com/opencv/opencv/archive/${OPENCV_VERSION}.zip -O opencv.zip; \
    wget -q https://github.com/opencv/opencv_contrib/archive/${OPENCV_VERSION}.zip -O opencv_contrib.zip; \
    unzip -q opencv.zip && unzip -q opencv_contrib.zip; \
    mv opencv-${OPENCV_VERSION} opencv && mv opencv_contrib-${OPENCV_VERSION} opencv_contrib; \
    mkdir -p opencv/build; cd opencv/build; \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D OPENCV_GENERATE_PKGCONFIG=ON \
          -D OPENCV_EXTRA_MODULES_PATH=/opt/opencv_contrib/modules \
          -D WITH_CUDA=ON \
          -D CUDA_ARCH_BIN=5.3 \
          -D WITH_CUDNN=ON \
          -D ENABLE_FAST_MATH=1 \
          -D CUDA_FAST_MATH=1 \
          -D WITH_GSTREAMER=ON \
          -D WITH_LIBV4L=ON \
          -D BUILD_opencv_python3=ON \
          -D PYTHON3_EXECUTABLE="${PYTHON3_EXEC}" \
          -D PYTHON3_INCLUDE_DIR="${PYTHON3_INCLUDE}" \
          -D PYTHON3_LIBRARY="${PYTHON3_LIB}" \
          -D PYTHON3_NUMPY_INCLUDE_DIRS="${NUMPY_INCLUDE}" \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_PERF_TESTS=OFF ..; \
    make -j2; \
    make install; \
    ldconfig; \
    cd /opt; rm -rf opencv opencv_contrib opencv.zip opencv_contrib.zip; \
    python3 -c "import cv2; print('opencv', cv2.__version__)"

WORKDIR /app
