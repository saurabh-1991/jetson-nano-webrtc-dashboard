# Environment Variables Example
# Copy to .env and configure for your environment

# Backend Configuration
JETSON_IP=192.168.1.11
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
LOG_LEVEL=INFO

# Camera Configuration
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA1_WIDTH=640
CAMERA1_HEIGHT=480
CAMERA1_FPS=30
CAMERA2_DEVICE=/dev/video1
CAMERA2_WIDTH=640
CAMERA2_HEIGHT=480
CAMERA2_FPS=30

# Camera acceleration policy (direct is most stable baseline on this target)
# Set CAMERA2_ACCELERATION=hardware to trial HW pipeline for cam2.
CAMERA_ACCELERATION=direct
CAMERA1_ACCELERATION=direct
CAMERA2_ACCELERATION=direct

# GPIO Configuration
GPIO_LED_PIN=12
GPIO_BUTTON_PIN=16

# CUDA Configuration
CUDA_ENABLED=True

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_DEBUG=False

# WebRTC Configuration
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302

# H264 live stream tuning (global defaults)
CAMERA_H264_STREAM_ENABLED=true
CAMERA_H264_STREAM_USE_GSTREAMER=true
CAMERA_H264_STREAM_BITRATE=1200000
CAMERA_H264_STREAM_GOP=15
CAMERA_H264_STREAM_MAX_FPS=20

# H264 live stream tuning (per camera overrides)
CAMERA1_H264_STREAM_ENABLED=true
CAMERA2_H264_STREAM_ENABLED=true
CAMERA1_H264_STREAM_USE_GSTREAMER=true
CAMERA2_H264_STREAM_USE_GSTREAMER=true
CAMERA1_H264_STREAM_BITRATE=1200000
CAMERA2_H264_STREAM_BITRATE=1000000
CAMERA1_H264_STREAM_GOP=15
CAMERA2_H264_STREAM_GOP=15
CAMERA1_H264_STREAM_MAX_FPS=30
CAMERA2_H264_STREAM_MAX_FPS=30

# H264 failure cooldown (avoid repeated failed probe thrash)
CAMERA_H264_FAIL_COOLDOWN_THRESHOLD=2
CAMERA_H264_FAIL_COOLDOWN_BASE_SECONDS=45
CAMERA_H264_FAIL_COOLDOWN_MAX_SECONDS=300
CAMERA_H264_FAIL_EARLY_SECONDS=3

# Optional Media Gateway (MediaMTX WHEP)
# Keep disabled unless mediamtx profile is running and reachable.
MEDIA_WEBRTC_GATEWAY_ENABLED=false
MEDIA_WEBRTC_GATEWAY_WHEP_TEMPLATE=http://jetson-mediamtx:8889/{camera_id}/whep
MEDIA_WEBRTC_GATEWAY_CAM1_WHEP_URL=
MEDIA_WEBRTC_GATEWAY_CAM2_WHEP_URL=

# Optional MediaMTX published ports (compose profile: media-gateway)
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_SIGNAL_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189
MEDIAMTX_API_PORT=9997

# Modbus RS-485 sensor configuration (tune based on datalogger register map)
MODBUS_ENABLED=true
# Transport mode:
# - serial: direct RS-485 adapter on Jetson
# - tcp: RTU-to-Ethernet converter (Modbus TCP gateway)
MODBUS_TRANSPORT=serial
MODBUS_PORT=/dev/ttyUSB0
MODBUS_HOST=
MODBUS_TCP_PORT=502
MODBUS_SLAVE_ID=1
MODBUS_BAUDRATE=9600
MODBUS_BYTESIZE=8
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_TIMEOUT=0.8
MODBUS_REGISTER_TYPE=holding

# Address conversion for datasheets that use logical register numbers.
# Examples:
# - If datasheet says 40001.. use MODBUS_ADDRESS_BASE=40001
# - If datasheet says 30001.. use MODBUS_ADDRESS_BASE=30001
# - Keep 0 when addresses are already 0-based wire addresses.
MODBUS_ADDRESS_BASE=0
MODBUS_ADDRESS_OFFSET=0

# Smart Log-04 field wiring / channel assignment used by code:
#   CH1 -> hot_zone_temperature
#   CH2 -> cold_zone_temperature
#   CH3 -> exhaust_temp
#   CH4 -> spare (not consumed by dashboard)
#
# ================= FIELD ENGINEER QUICK CHECKLIST =================
# A) Confirm serial settings at site (slave/baud/parity/stopbits) match logger.
# B) Confirm register class: holding vs input (MODBUS_REGISTER_TYPE).
# C) If manual prints 30001/40001 style addresses, set MODBUS_ADDRESS_BASE.
# D) Verify each channel status register returns 0 (in range).
# E) If channel wiring differs, ONLY remap the *_VALUE/*_DECIMAL/*_STATUS vars below.
# ==================================================================
#
# Register map (as provided):
# CH1: value=0010, decimal=0011, status=0012
# CH2: value=0013, decimal=0014, status=0015
# CH3: value=0016, decimal=0017, status=0018
# CH4: value=0019, decimal=0020, status=0021
#
# Example remap #1 (if field wiring is CH2->hot, CH3->cold, CH1->exhaust):
#   MODBUS_ADDR_HOT_ZONE_VALUE=13
#   MODBUS_ADDR_HOT_ZONE_DECIMAL=14
#   MODBUS_ADDR_HOT_ZONE_STATUS=15
#   MODBUS_ADDR_COLD_ZONE_VALUE=16
#   MODBUS_ADDR_COLD_ZONE_DECIMAL=17
#   MODBUS_ADDR_COLD_ZONE_STATUS=18
#   MODBUS_ADDR_EXHAUST_VALUE=10
#   MODBUS_ADDR_EXHAUST_DECIMAL=11
#   MODBUS_ADDR_EXHAUST_STATUS=12
#
# Example remap #2 (if only hot and cold are swapped):
#   HOT -> CH2 (13/14/15), COLD -> CH1 (10/11/12), EXHAUST -> CH3 (16/17/18)

# Temperature channel mapping (Smart Log-04 defaults)
MODBUS_ADDR_HOT_ZONE_VALUE=10
MODBUS_ADDR_HOT_ZONE_DECIMAL=11
MODBUS_ADDR_HOT_ZONE_STATUS=12
# Backward-compatible alias (value register)
MODBUS_ADDR_HOT_ZONE=10
MODBUS_SCALE_HOT_ZONE=0.1
MODBUS_OFFSET_HOT_ZONE=0.0
MODBUS_SIGNED_HOT_ZONE=true
MODBUS_TYPE_HOT_ZONE=

MODBUS_ADDR_COLD_ZONE_VALUE=13
MODBUS_ADDR_COLD_ZONE_DECIMAL=14
MODBUS_ADDR_COLD_ZONE_STATUS=15
# Backward-compatible alias (value register)
MODBUS_ADDR_COLD_ZONE=13
MODBUS_SCALE_COLD_ZONE=0.1
MODBUS_OFFSET_COLD_ZONE=0.0
MODBUS_SIGNED_COLD_ZONE=true
MODBUS_TYPE_COLD_ZONE=

MODBUS_ADDR_EXHAUST_VALUE=16
MODBUS_ADDR_EXHAUST_DECIMAL=17
MODBUS_ADDR_EXHAUST_STATUS=18
# Backward-compatible alias (value register)
MODBUS_ADDR_EXHAUST=16
MODBUS_SCALE_EXHAUST=0.1
MODBUS_OFFSET_EXHAUST=0.0
MODBUS_SIGNED_EXHAUST=true
MODBUS_TYPE_EXHAUST=

# Optional separate Flow Meter device (independent from datalogger channels)
FLOW_METER_ENABLED=false
# Typical for RS485->Ethernet converter deployments:
FLOW_METER_TRANSPORT=tcp
FLOW_METER_HOST=
FLOW_METER_TCP_PORT=502

# Use these when FLOW_METER_TRANSPORT=serial
FLOW_METER_PORT=/dev/ttyUSB1
FLOW_METER_BAUDRATE=9600
FLOW_METER_BYTESIZE=8
FLOW_METER_PARITY=N
FLOW_METER_STOPBITS=1

FLOW_METER_SLAVE_ID=1
FLOW_METER_TIMEOUT=0.8
FLOW_METER_REGISTER_TYPE=holding
FLOW_METER_ADDRESS_BASE=0
FLOW_METER_ADDRESS_OFFSET=0

# Primary flow value register and optional decimal/status registers
FLOW_METER_VALUE_ADDRESS=0
FLOW_METER_DECIMAL_ADDRESS=
FLOW_METER_STATUS_ADDRESS=

# Fallback conversion if decimal register is not used
FLOW_METER_SCALE=0.1
FLOW_METER_OFFSET=0.0
FLOW_METER_SIGNED=false
FLOW_METER_MIN_VALUE=0.0
FLOW_METER_MAX_VALUE=99999.0
FLOW_METER_FAILURE_BACKOFF_SECONDS=5.0

# Fallback behaviour when datalogger read fails repeatedly
MODBUS_FAILURE_BACKOFF_SECONDS=5.0
SENSOR_SIMULATION_ENABLED=false

# Field commissioning logs (raw register triplets + processed values)
# Enable temporarily while validating mapping/wiring onsite.
SENSOR_DEBUG_LOG_RAW=false
SENSOR_DEBUG_LOG_INTERVAL_SECONDS=8.0
SENSOR_DEBUG_LOG_ONLY_ON_CHANGE=true

# Video storage pipeline (segmented recording + background upload)
VIDEO_SEGMENT_SECONDS=60
VIDEO_UPLOAD_MAX_PARALLEL_PER_CAMERA=2
VIDEO_UPLOAD_MAX_RETRIES=7
VIDEO_UPLOAD_RETRY_BASE_SECONDS=1
VIDEO_STORAGE_PROVIDER=local
VIDEO_STORAGE_BUCKET_OR_CONTAINER=
VIDEO_STORAGE_PREFIX=v1/lab-a
VIDEO_RETENTION_HOT_DAYS=7
VIDEO_RETENTION_WARM_DAYS=30
VIDEO_RETENTION_ARCHIVE_DAYS=180
VIDEO_COMPLIANCE_MODE=off

# Docker Configuration
COMPOSE_PROJECT_NAME=jetson-dashboard
